            <Textbox Name="Legend">
              <Paragraphs>
                <Paragraph>
                  <TextRuns>
                    <TextRun>
                      <Value>To be marked as follows:
'H' for holidays allowed
'W/D' for work on double wages
'W/H' for work with substituted holiday
'N/E' if not eligible for wages</Value>
                      <Style>
                        <FontSize>7pt</FontSize>
                      </Style>
                    </TextRun>
                  </TextRuns>
                  <Style />
                </Paragraph>
              </Paragraphs>
              <Top>0.1in</Top>
