                            <Textbox Name="HeaderTxt">
                              <CanGrow>true</CanGrow>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>Form A</Value>
                                      <Style>
                                        <FontFamily>Nirmala UI</FontFamily>
                                        <FontSize>14pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>(See sub-rule (1) of Rule 3 of the Tamil Nadu Maternity Benefit Rules, 1967.)</Value>
                                      <Style>
                                        <FontFamily>Nirmala UI</FontFamily>
                                        <FontSize>9pt</FontSize>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>REGISTER OF MUSTER ROLL</Value>
                                      <Style>
                                        <FontFamily>Nirmala UI</FontFamily>
                                        <FontSize>16pt</FontSize>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>வேலை செய்யும் பெண்ணின் பிரசவ சம்பந்தமாய் கொடுக்கப்பட்ட சகாயத் தொகையைக் குறிக்கும் பதிவேடு</Value>
                                      <Style>
                                        <FontFamily>Nirmala UI</FontFamily>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style>
                                    <TextAlign>Center</TextAlign>
                                  </Style>
                                </Paragraph>
                              </Paragraphs>
                              <Top>0.05in</Top>
                              <Height>1.2in</Height>
                              <Width>7.8in</Width>
                              <Style />
                            </Textbox>
                            <Textbox Name="L10d">
                              <CanGrow>true</CanGrow>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value> (d) Leave wages as per Section 9: </Value>
                                      <Style>
                                        <FontFamily>Nirmala UI</FontFamily>
                                      </Style>
                                    </TextRun>
                                    <TextRun>
                                      <Value>="---- " &amp; Fields!LeaveWagesSec9.Value</Value>
                                      <Style>
                                        <FontFamily>Nirmala UI</FontFamily>
                                        <FontWeight>Bold</FontWeight>
                                      </Style>
                                    </TextRun>
                                  </TextRuns>
                                  <Style />
                                </Paragraph>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>      9-வது பிரிவின்படி ரஜா நாட்களின் சம்பளத்தொகை</Value>
