  <ReportSections>
    <ReportSection>
      <Width>7.8in</Width>
      <Body>
        <ReportItems>
          <Textbox Name="Title">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>Form No. VI / படிவம் எண். VI</Value>
                    <Style>
                      <FontFamily>Nirmala UI</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <FontSize>12pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Center</TextAlign></Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>[See Rule 7 (1) of The Tamil Nadu Industrial Establishments (National and Festival Holidays) Rules, 1959]</Value>
                    <Style>
                      <FontFamily>Nirmala UI</FontFamily>
                      <FontSize>8pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Center</TextAlign></Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Register of National &amp; Festival Holidays for the year " &amp; Fields!Year.Value</Value>
                    <Style>
                      <FontFamily>Nirmala UI</FontFamily>
                      <FontWeight>Bold</FontWeight>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Center</TextAlign></Style>
              </Paragraph>
            </Paragraphs>
            <Height>0.75in</Height>
            <Width>7.8in</Width>
          </Textbox>
          
          <Textbox Name="InstructionsCombined">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>To be marked as follows / கீழ்கண்டபடி குறிக்கவும் :&#13;&#10;H - for holiday allowed / அனுமதித்த விடுமுறை&#13;&#10;W/D - for work on double wages / வேலை செய்தால் இரட்டை ஊதியம்&#13;&#10;W/H - for work with substituted holiday / வேலை செய்தால் மாற்று விடுமுறை&#13;&#10;N/E - if not eligible for wages / ஊதியம் பெற தகுதியற்றவர்</Value>
                    <Style>
                      <FontFamily>Nirmala UI</FontFamily>
                      <FontSize>7.5pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
              </Paragraph>
            </Paragraphs>
            <Top>0.8in</Top>
            <Height>0.7in</Height>
            <Width>5in</Width>
          </Textbox>

          <Tablix Name="Tablix1">
            <TablixBody>
