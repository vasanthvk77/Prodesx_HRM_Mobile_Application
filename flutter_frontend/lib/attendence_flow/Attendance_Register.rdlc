                  </TextRun>
                  <TextRun>
                    <Value>=First(Fields!MonthYear.Value, "AttendanceDataSet")</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>11pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
