        <ReportItems>
          <Textbox Name="FormTitle">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>FORM XXV: REGISTER OF ATTENDANCE / MUSTER ROLL</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style>
                  <TextAlign>Center</TextAlign>
                </Style>
              </Paragraph>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>(Prescribed under Rule 103 of the Tamil Nadu Factories Rules, 1950)</Value>
                    <Style>
                      <FontFamily>Times New Roman</FontFamily>
                      <FontSize>16pt</FontSize>
                      <TextDecoration>None</TextDecoration>
                    </Style>
                  </TextRun>
